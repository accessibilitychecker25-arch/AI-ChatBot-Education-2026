{
  "buildCommand": "npm run build -- --base-href /",
  "outputDirectory": "docs",
  "rewrites": [
    {
      "source": "/api/upload-document",
      "destination": "https://ai-chat-bot-education-2026-kwitichdd.vercel.app/api/upload-document"
    },
    {
      "source": "/api/download-document",
      "destination": "https://ai-chat-bot-education-2026-kwitichdd.vercel.app/api/download-document"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
